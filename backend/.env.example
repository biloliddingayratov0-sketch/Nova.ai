# ═══════════════════════════════════════════════════════════════════
# NOVA AI — Master SaaS Platform Environment Configuration
# ═══════════════════════════════════════════════════════════════════

# --- AI API Keys & Provider Settings ---
# OpenAI API key — for DALL-E, GPT-4o, Whisper, and TTS
OPENAI_API_KEY=your_openai_api_key_here

# Models (Validated official model identifiers)
AI_IMAGE_MODEL=dall-e-3
AI_IMAGE_EDIT_MODEL=dall-e-2
AI_CHAT_MODEL=gpt-4o-mini
AI_CODE_MODEL=gpt-4o-mini
AI_VIDEO_MODEL=nova-video-v1
AI_AUDIO_MODEL=tts-1

# --- Database & Storage ---
# SQLite for local dev, PostgreSQL for production
# Example PostgreSQL: postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/nova_ai
DATABASE_URL=sqlite:///./nova_ai.db

# --- Security & JWT Authentication ---
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Rate Limiting & Networking ---
RATE_LIMIT_PER_MINUTE=60
FRONTEND_URL=http://127.0.0.1:5500

# --- Uzbekistan Payment Gateways ---
# CLICK Merchant API credentials (https://click.uz)
CLICK_SERVICE_ID=test_click_service_id
CLICK_MERCHANT_ID=test_click_merchant_id
CLICK_SECRET_KEY=test_click_secret_key

# PAYME Merchant API credentials (https://payme.uz)
PAYME_MERCHANT_ID=test_payme_merchant_id
PAYME_SECRET_KEY=test_payme_secret_key

# UZUM Bank / Uzum Pay credentials (https://uzumbank.uz)
UZUM_MERCHANT_ID=test_uzum_merchant_id
UZUM_SECRET_KEY=test_uzum_secret_key
